# ~/.config/levbush.env  (chmod 600)

# Бот (@BotFather): токен; в группу — обычным участником (админ не нужен)
LEVBUSH_BOT_TOKEN=
# Твой Telegram id: уведомления, /status, /analyze
LEVBUSH_ADMIN_ID=
# Группа: @username, id (-100…) или ссылка. Можно указать канал — возьмётся его группа обсуждения
LEVBUSH_GROUP=

# Telethon (my.telegram.org → API development tools), вход один раз: levbush login
LEVBUSH_API_ID=
LEVBUSH_API_HASH=

# База: Supabase → Connect → Transaction pooler, порт 6543 (5432 режет VPN sbx)
# postgresql://postgres.xmtzjuyoqmjrhegbdrzx:<ПАРОЛЬ>@aws-…-eu-central-1.pooler.supabase.com:6543/postgres
LEVBUSH_DATABASE_URL=

# Сайт (GitHub Pages) — он же Mini App; короткое имя приложения из /newapp (для кнопки в группе)
LEVBUSH_WEBAPP_URL=https://egoriumas.github.io/levbush-relationships/
LEVBUSH_WEBAPP_NAME=

# Чьи сообщения «от имени группы» (аноним-админ) и «от имени канала» (не автопересылки): id=@ник через запятую
LEVBUSH_ALIASES=

LEVBUSH_TZ=Europe/Moscow
# Кэш переписки (SQLite) и медиа
LEVBUSH_DATA_DIR=~/.local/share/levbush
LEVBUSH_MEDIA_DIR=/mnt/shared/levbush/media

# Модели (vLLM), поднимаются и гасятся ботом сами, на GPU — одна за раз
# Nemotron 3 Nano Omni — описания звука и видео
LEVBUSH_LLM_URL=http://127.0.0.1:18090
# Qwen — досье, связи, пересказ (пусто в QWEN_MODEL_PATH — всё делает Nemotron)
LEVBUSH_QWEN_URL=http://127.0.0.1:18091
LEVBUSH_QWEN_MODEL_PATH=/mnt/shared/Models/qwen38-27b-nvfp4
# LEVBUSH_QWEN_MTP=3        # 0 — без MTP
# LEVBUSH_QWEN_KV=turboquant_k8v4   # с MTP — только с патчем vLLM (deploy/vllm-0.27.1-turboquant-mtp.patch), иначе fp8
# LEVBUSH_QWEN_CTX=180224   # k8v4 вмещает ~192k токенов; с fp8 — не больше 150k
# LEVBUSH_QWEN_SEQS=1       # слоты: два запроса с картинками + MTP роняют vLLM 0.27.1
# Общий сервер пользователя — пересказ сначала идёт туда
# LEVBUSH_FALLBACK_LLM_URL=http://127.0.0.1:8080
LEVBUSH_DAILY_AT=04:30

# Поиск /find: индекс в DATA_DIR/search.db (только локально). Векторы — jina-embeddings-v5-omni-small-retrieval
# в отдельном процессе системного python3 (torch, transformers); нет модели — поиск только по словам
# LEVBUSH_SEARCH=1
# LEVBUSH_EMBED_MODEL=/mnt/shared/Models/jina-v5-omni-small-retrieval
# LEVBUSH_EMBED_PYTHON=/usr/bin/python3
# LEVBUSH_EMBED_DIM=1024          # Matryoshka: 512/768 — меньше файл, чуть хуже; смена пересчитывает все векторы
# LEVBUSH_EMBED_DEVICE=auto       # auto — GPU, если очередь ≥ EMBED_GPU_MIN и GPU свободен (нет модели бота, H3,
#                                 #   свободно ≥ EMBED_NEED_GIB), иначе CPU; cpu / cuda — принудительно
# LEVBUSH_EMBED_NEED_GIB=6
# LEVBUSH_EMBED_GPU_MIN=2000
# LEVBUSH_EMBED_THREADS=8         # потоков torch на CPU (индексация и запросы)
# LEVBUSH_EMBED_MAX_PIXELS=1310720  # картинка: 256–1280 токенов; меньше — быстрее на CPU
# LEVBUSH_EMBED_IDLE_MIN=15       # эмбеддер запросов гасится после простоя
# LEVBUSH_SEARCH_INTERVAL=300     # как часто индекс догоняет кэш, с
# LEVBUSH_SEARCH_AUTO_MAX=3000    # фоновая дозаливка — пока очередь не больше; всю историю — /index run
# LEVBUSH_FIND_PER_PAGE=7
