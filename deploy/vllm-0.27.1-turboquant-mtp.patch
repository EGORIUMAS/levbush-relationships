 # ---------------------------------------------------------------------------
+# [levbush patch] Grouped stage1: одна программа на (запрос, kv-голова, кусок KV).
+# Блок кэша читается и распаковывается один раз на все Hq/Hk голов группы и все
+# L токенов запроса (1 + k токенов проверки MTP); скоры и взвешивание значений —
+# через tl.dot. У каждой строки (токен t, голова g) своя каузальная длина
+# Seq_lens[tok] — токен t видит seq_len_req - (L - 1) + t токенов. Куски KV
+# считаются по длине последнего токена запроса (самой большой) — так же их
+# потом разбирает stage2 (ему передаются эти длины).
+# ---------------------------------------------------------------------------
+@triton.jit
+def _tq_decode_stage1_grouped(
+    Q_rot_ptr,  # [B_tok, Hq, D]
+    KV_cache_ptr,
+    Block_table_ptr,  # [B_tok, max_num_blocks] (строки токенов одного запроса одинаковы)
+    Seq_lens_ptr,  # [B_tok] int32 — каузальная длина каждого токена
+    Centroids_ptr,
+    Mid_o_ptr,  # [B_tok, Hq, NUM_KV_SPLITS, D+1]
+    stride_qb,
+    stride_qh,
+    stride_cache_block,
+    stride_cache_pos,
+    stride_cache_head,
+    stride_bt_b,
+    stride_mid_b,
+    stride_mid_h,
+    stride_mid_s,
+    HEAD_DIM: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+    NUM_KV_SPLITS: tl.constexpr,
+    KV_GROUP_SIZE: tl.constexpr,
+    TOKENS_PER_REQ: tl.constexpr,
+    BLOCK_H: tl.constexpr,  # next_pow2(TOKENS_PER_REQ * KV_GROUP_SIZE), >= 16
+    MSE_BITS: tl.constexpr,
+    MSE_BYTES: tl.constexpr,
+    KPS: tl.constexpr,
+    VQB: tl.constexpr,
+    VAL_DATA_BYTES: tl.constexpr,
+    ATTN_SCALE: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+    BLOCK_KV: tl.constexpr,
+    KEY_FP8: tl.constexpr,
+    NORM_CORRECTION: tl.constexpr = 0,
+    FP8_E4B15: tl.constexpr = 0,
+):
+    rid = tl.program_id(0)  # запрос
+    kv_head = tl.program_id(1)
+    sid = tl.program_id(2)
+
+    rows = tl.arange(0, BLOCK_H)
+    row_ok = rows < TOKENS_PER_REQ * KV_GROUP_SIZE
+    t = rows // KV_GROUP_SIZE
+    g = rows % KV_GROUP_SIZE
+    tok = rid * TOKENS_PER_REQ + tl.where(row_ok, t, 0)
+    head = kv_head * KV_GROUP_SIZE + g
+
+    row_len = tl.load(Seq_lens_ptr + tok, mask=row_ok, other=0)
+    part_len = tl.load(Seq_lens_ptr + rid * TOKENS_PER_REQ + TOKENS_PER_REQ - 1)
+    split_len = tl.cdiv(part_len, NUM_KV_SPLITS)
+    split_start = split_len * sid
+    split_end = tl.minimum(split_start + split_len, part_len)
+    if split_start >= split_end:
+        return
+
+    d_offs = tl.arange(0, BLOCK_D)
+    d_mask = d_offs < HEAD_DIM
+    kv_range = tl.arange(0, BLOCK_KV)
+
+    q = tl.load(
+        Q_rot_ptr + tok[:, None] * stride_qb + head[:, None] * stride_qh + d_offs[None, :],
+        mask=row_ok[:, None] & d_mask[None, :],
+        other=0.0,
+    )
+    if KEY_FP8:
+        q = q.to(tl.bfloat16)  # запрос уже bf16/fp16, ключ fp8 -> bf16 без потерь
+    else:
+        q = q.to(tl.float32)  # повёрнутый запрос (fp32) — скоры в tf32
+
+    if not KEY_FP8:
+        mse_bit_off = d_offs * MSE_BITS
+        mse_byte_idx = mse_bit_off // 8
+        mse_bit_shift = mse_bit_off % 8
+        mse_mask = (1 << MSE_BITS) - 1
+    if VQB == 3:
+        val_bit_off = d_offs * 3
+        val_byte_idx = val_bit_off // 8
+        val_bit_shift = val_bit_off % 8
+
+    m_prev = tl.full([BLOCK_H], -float("inf"), dtype=tl.float32)
+    l_prev = tl.zeros([BLOCK_H], dtype=tl.float32)
+    acc = tl.zeros([BLOCK_H, BLOCK_D], dtype=tl.float32)
+
+    bt_base = (rid * TOKENS_PER_REQ).to(tl.int64) * stride_bt_b
+
+    for start_n in range(split_start, split_end, BLOCK_KV):
+        kv_offs = start_n + kv_range
+        kv_mask = kv_offs < split_end
+        page_idx = kv_offs // BLOCK_SIZE
+        page_off = kv_offs % BLOCK_SIZE
+        block_nums = tl.load(Block_table_ptr + bt_base + page_idx, mask=kv_mask, other=0).to(tl.int64)
+        slot_bases = (
+            block_nums * stride_cache_block
+            + page_off.to(tl.int64) * stride_cache_pos
+            + tl.cast(kv_head, tl.int64) * stride_cache_head
+        )
+        tile_mask = kv_mask[:, None] & d_mask[None, :]
+
+        # --- ключи: [BLOCK_KV, BLOCK_D] -> скоры [BLOCK_H, BLOCK_KV]
+        if KEY_FP8:
+            k_raw = tl.load(KV_cache_ptr + slot_bases[:, None] + d_offs[None, :], mask=tile_mask, other=0)
+            if FP8_E4B15:
+                k_float = k_raw.to(tl.float8e4b15, bitcast=True).to(tl.float32)
+            else:
+                k_float = k_raw.to(tl.float8e4nv, bitcast=True).to(tl.float32)
+            k_bf = tl.where(tile_mask, k_float, 0.0).to(tl.bfloat16)
+            scores = tl.dot(q, tl.trans(k_bf)) * ATTN_SCALE
+        else:
+            mse_addrs0 = slot_bases[:, None] + mse_byte_idx[None, :]
+            mse_raw0 = tl.load(KV_cache_ptr + mse_addrs0, mask=tile_mask, other=0).to(tl.int32)
+            mse_raw1 = tl.load(KV_cache_ptr + mse_addrs0 + 1, mask=tile_mask, other=0).to(tl.int32)
+            mse_idx = ((mse_raw0 | (mse_raw1 << 8)) >> mse_bit_shift[None, :]) & mse_mask
+            c_vals = tl.load(Centroids_ptr + mse_idx, mask=tile_mask, other=0.0)
+            if NORM_CORRECTION:
+                c_norm_sq = tl.sum(tl.where(d_mask[None, :], c_vals * c_vals, 0.0), axis=1)
+                c_vals = c_vals * (1.0 / tl.sqrt(c_norm_sq + 1e-16))[:, None]
+            c_vals = tl.where(tile_mask, c_vals, 0.0)
+            norm_bases = slot_bases + MSE_BYTES
+            n_lo = tl.load(KV_cache_ptr + norm_bases, mask=kv_mask, other=0).to(tl.uint16)
+            n_hi = tl.load(KV_cache_ptr + norm_bases + 1, mask=kv_mask, other=0).to(tl.uint16)
+            vec_norms = (n_lo | (n_hi << 8)).to(tl.float16, bitcast=True).to(tl.float32)
+            scores = tl.dot(q, tl.trans(c_vals), input_precision="tf32") * (vec_norms * ATTN_SCALE)[None, :]
+
+        valid = row_ok[:, None] & kv_mask[None, :] & (kv_offs[None, :] < row_len[:, None])
+        scores = tl.where(valid, scores, -float("inf"))
+
+        # --- онлайн-softmax по строкам (строка без валидных токенов не даёт NaN)
+        n_e_max = tl.maximum(tl.max(scores, 1), m_prev)
+        safe_max = tl.where(n_e_max == -float("inf"), 0.0, n_e_max)
+        re_scale = tl.exp(m_prev - safe_max)
+        p = tl.exp(scores - safe_max[:, None])
+
+        # --- значения: [BLOCK_KV, BLOCK_D]
+        val_bases = slot_bases + KPS
+        if VQB == 3:
+            val_addrs0 = val_bases[:, None] + val_byte_idx[None, :]
+            val_raw0 = tl.load(KV_cache_ptr + val_addrs0, mask=tile_mask, other=0).to(tl.int32)
+            val_raw1 = tl.load(KV_cache_ptr + val_addrs0 + 1, mask=tile_mask, other=0).to(tl.int32)
+            v_idx = (((val_raw0 | (val_raw1 << 8)) >> val_bit_shift[None, :]) & 0x7).to(tl.float32)
+        else:  # VQB == 4
+            val_raw = tl.load(KV_cache_ptr + val_bases[:, None] + (d_offs // 2)[None, :], mask=tile_mask,
+                              other=0).to(tl.int32)
+            v_idx = ((val_raw >> ((d_offs % 2) * 4)[None, :]) & 0xF).to(tl.float32)
